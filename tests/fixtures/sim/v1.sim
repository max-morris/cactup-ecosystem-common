format = 1

[sim]
name = "bhns-example"
summary = "A minimal example"
authors = ["A. Author"]
root = "Cactus"

[thornlist]
filename = "x.th"
text = """
!CRL_VERSION = 1.0
"""

[parfile]
filename = "x.par"
kind = "par"
text = """
ActiveThorns = "CarpetX"
"""

[[repo]]
name = "carpetx"
url = "https://github.com/example/CarpetX.git"
ref = "main"
commit = "3f2c9e1a00112233445566778899aabbccddeeff"
